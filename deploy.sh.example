#!/bin/bash
# ====================================================================
# TEMPLATE SKRIP DEPLOYMENT QUARTZ UNTUK LINUX / MACOS (deploy.sh.example)
# Salin file ini menjadi 'deploy.sh' (deploy.sh otomatis di-ignore Git)
# ====================================================================

set -e

echo "[1/3] Membangun situs Quartz..."
npx quartz build

echo "[2/3] Meng-add & commit perubahan catatan..."
git add .
git commit -m "docs: sync notes [$(date '+%Y-%m-%d %H:%M:%S')]"

echo "[3/3] Mempublikasikan ke GitHub Pages..."
git push origin v4

echo "✅ Selesai! Perubahan telah dikirim ke GitHub."
